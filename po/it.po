#: virtux/dialogs.py:143
msgid "Internal — stored inside the disk image"
msgstr "Interno — memorizzato dentro l’immagine del disco"

#: virtux/dialogs.py:145
msgid "Internal — full checkpoint including memory"
msgstr "Interno — checkpoint completo, memoria inclusa"

#: virtux/dialogs.py:147
